generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MEMBER
  ADMIN
  SUPER_ADMIN
}

enum MembershipRole {
  MEMBER
  ADMIN
}

enum ContributionStatus {
  PENDING
  PAID
  OVERDUE
}

enum LoanStatus {
  REQUESTED
  APPROVED
  REJECTED
  ACTIVE
  PAID
  OVERDUE
}

enum TransactionType {
  CONTRIBUTION
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  ADJUSTMENT
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(MEMBER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  memberships   Membership[]
  contributions Contribution[]
  loans         Loan[]
  transactions  Transaction[]
}

model Group {
  id                  String         @id @default(uuid())
  name                String
  description         String?
  monthlyContribution Decimal        @db.Decimal(12, 2)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  memberships         Membership[]
  contributions       Contribution[]
  loans               Loan[]
  transactions        Transaction[]
}

model Membership {
  id        String         @id @default(uuid())
  userId    String
  groupId   String
  role      MembershipRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model Contribution {
  id            String             @id @default(uuid())
  groupId       String
  userId        String
  amount        Decimal            @db.Decimal(12, 2)
  date          DateTime
  status        ContributionStatus @default(PENDING)
  createdAt     DateTime           @default(now())

  group         Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, date])
  @@index([userId, date])
}

model Loan {
  id              String       @id @default(uuid())
  groupId         String
  userId          String
  amount          Decimal      @db.Decimal(12, 2)
  interestRate    Decimal      @db.Decimal(5, 2)
  dueDate         DateTime
  status          LoanStatus   @default(REQUESTED)
  approvedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  group           Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, dueDate])
  @@index([userId, dueDate])
}

model Transaction {
  id          String          @id @default(uuid())
  groupId     String
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  referenceId String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  group       Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, date])
  @@index([userId, date])
}
