generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  TREASURER
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum GroupStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum CycleType {
  WEEKLY
  MONTHLY
}

enum ContributionStatus {
  PENDING
  PAID
  LATE
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TransactionType {
  CONTRIBUTION
  LOAN
  LOAN_PAYMENT
  WITHDRAW
  DEPOSIT
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id                 String         @id @default(uuid())
  firstName          String
  lastName           String
  email              String         @unique
  phone              String?        @unique
  passwordHash       String
  avatar             String?
  isVerified         Boolean        @default(false)
  status             UserStatus     @default(ACTIVE)
  resetPasswordToken     String?    @unique
  resetPasswordExpiresAt DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  createdGroups      Group[]        @relation("GroupCreator")
  memberships        Membership[]
  contributions      Contribution[]
  loans              Loan[]         @relation("LoanBorrower")
  approvedLoans      Loan[]         @relation("LoanApprover")
  transactions       Transaction[]
  notifications      Notification[]
  invitationsSent    Invitation[]   @relation("InvitationSender")
  auditLogs          AuditLog[]
}

model Group {
  id                  String          @id @default(uuid())
  name                String
  description         String?
  monthlyContribution Decimal         @db.Decimal(12, 2)
  currency            String          @default("AOA")
  maxMembers          Int?
  cycleType           CycleType       @default(MONTHLY)
  startDate           DateTime        @db.Date
  status              GroupStatus     @default(ACTIVE)
  createdBy           String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  creator             User            @relation("GroupCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  settings            GroupSettings?
  memberships         Membership[]
  contributions       Contribution[]
  loans               Loan[]
  transactions        Transaction[]
  invitations         Invitation[]
  auditLogs           AuditLog[]

  @@index([status])
}

model Membership {
  id        String          @id @default(uuid())
  userId    String
  groupId   String
  role      MembershipRole  @default(MEMBER)
  joinedAt  DateTime        @default(now())
  isActive  Boolean         @default(true)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  trustScore TrustScore?

  @@unique([userId, groupId])
  @@index([groupId, isActive])
}

model Contribution {
  id             String             @id @default(uuid())
  groupId        String
  userId         String
  amount         Decimal            @db.Decimal(12, 2)
  referenceMonth DateTime           @db.Date
  status         ContributionStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime           @default(now())

  group          Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, referenceMonth])
  @@index([userId, referenceMonth])
}

model Loan {
  id            String         @id @default(uuid())
  groupId       String
  userId        String
  amount        Decimal        @db.Decimal(12, 2)
  interestRate  Decimal        @db.Decimal(5, 2)
  reason        String?
  status        LoanStatus     @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  dueDate       DateTime       @db.Date
  createdAt     DateTime       @default(now())

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  borrower      User           @relation("LoanBorrower", fields: [userId], references: [id], onDelete: Cascade)
  approver      User?          @relation("LoanApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  payments      LoanPayment[]

  @@index([groupId, status])
  @@index([userId, dueDate])
}

model LoanPayment {
  id          String         @id @default(uuid())
  loanId       String
  amount       Decimal        @db.Decimal(12, 2)
  paidAt       DateTime
  createdAt    DateTime       @default(now())

  loan         Loan           @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, paidAt])
}

model Transaction {
  id          String          @id @default(uuid())
  groupId     String
  userId      String
  type        TransactionType
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now())

  group       Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id          String            @id @default(uuid())
  userId      String
  title       String
  message     String
  type        NotificationType  @default(INFO)
  isRead      Boolean           @default(false)
  createdAt   DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Invitation {
  id          String            @id @default(uuid())
  groupId      String
  email        String
  token        String            @unique
  status       InvitationStatus  @default(PENDING)
  expiresAt    DateTime
  createdBy    String?
  createdAt    DateTime          @default(now())

  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender       User?             @relation("InvitationSender", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([email])
}

model AuditLog {
  id          String     @id @default(uuid())
  userId      String
  groupId     String?
  action      String
  entity      String
  entityId    String
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  group       Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([groupId, createdAt])
}

model GroupSettings {
  id                    String    @id @default(uuid())
  groupId               String    @unique
  defaultInterestRate   Decimal   @db.Decimal(5, 2)
  collectionDay         Int
  maxMembers            Int?
  requireLoanApproval   Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  group                 Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model TrustScore {
  id                String     @id @default(uuid())
  membershipId      String     @unique
  score             Int        @default(0)
  onTimePayments    Int        @default(0)
  latePayments      Int        @default(0)
  lastCalculatedAt  DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  membership        Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([score])
}
